#!/bin/sh
set -uxe

cd ..
./run base
cd kilobase

brew analytics off
brew bundle install -v

dart pub global activate fvm
dart pub global run fvm:main install stable

gh api /user/memberships/orgs --jq 'map(.organization.login) + ["'"$(gh api /user --jq .login)"'", "CMJanina"] | join("\n")' | \
    grep -Ev 'EpicGames|tldr-pages' | \
    xe -j0 -L -- gh repo list -L 1000 --no-archived --json owner,name --jq 'map(.owner.login + "/" + .name) | join("\n")' | \
    sort -u | \
    xe -vj10 -s '[ -d ~/src/$1 ] || gh repo clone $1 ~/src/$1 -- --recurse-submodules -qv'

mkdir -p "$HOME/.local/share/helix"
gh api /user/memberships/orgs --jq 'map(.organization.login) + ["'"$(gh api /user --jq .login)"'"] | join("\n")' | \
    xe -j0 -- bash -c 'shopt -s nullglob ; for x in $HOME/src/$1/* ; do echo $x ; done' -s | \
    xe -j0 -s 'grep $1 $HOME/.local/share/helix/trusted_workspaces >/dev/null || echo $1' | \
    tee -a "$HOME/.local/share/helix/trusted_workspaces"
